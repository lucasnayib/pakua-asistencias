DATABASE_URL="file:./dev.db"

# Sesión de administrador
SESSION_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-en-produccion"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-contrasena"

# OBLIGATORIO poner en "true" en producción (cualquier dominio servido por HTTPS, ej. un
# túnel de Cloudflare) — si no, la cookie de sesión viaja sin el flag Secure. Mientras se
# acceda por HTTP en la LAN de desarrollo, dejar sin definir o en "false", si no el
# navegador descarta la cookie.
COOKIE_SECURE="false"

# Google Drive (opcional). Si se dejan vacíos, la exportación solo descarga el archivo localmente.
# 1. Crear un Service Account en Google Cloud Console con la API de Drive habilitada.
# 2. Compartir la carpeta de destino con el email del Service Account.
# 3. Completar estas variables con los datos del JSON de credenciales.
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# Backup automático a Google Drive (opcional, reusa el Service Account de arriba). Carpeta
# aparte de GOOGLE_DRIVE_FOLDER_ID a propósito: el backup nocturno borra solo los .zip viejos
# de ESTA carpeta para no acumular espacio sin límite, y así nunca puede tocar un archivo
# exportado por una escuela. Si se deja vacía, el backup local se sigue haciendo igual, solo
# que no se sube copia a Drive.
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""

# Envío de mails (opcional, vía Resend: https://resend.com). Si se dejan vacíos, todo el resto
# de la app sigue funcionando igual, simplemente no se envía ningún mail (registro/aprobación/
# rechazo de escuelas, recuperar contraseña, avisos de suscripción, bajas por inactividad, etc.).
# 1. Crear cuenta en https://resend.com y verificar un dominio propio (Domains -> Add Domain):
#    agrega los registros DNS que te indique (SPF/DKIM) en el proveedor del dominio (ej.
#    Cloudflare) — sin el dominio verificado, Resend solo deja mandar a tu propio mail de prueba.
# 2. Generar una API key en Resend (API Keys -> Create) y ponerla en RESEND_API_KEY.
RESEND_API_KEY=""
# Remitente que van a ver los destinatarios. Debe usar el dominio verificado en Resend.
EMAIL_FROM="Pakua Asistencias <notificaciones@tudominio.com>"
# A dónde llegan los avisos de "solicitud de escuela nueva".
EMAIL_ADMIN_NOTIFICATIONS=""

# Opcional: si está seteada, los mails incluyen links directos al panel/escuela (ej.
# "https://tudominio.com"). Sin dominio propio todavía, dejar vacío — los mails igual
# se mandan, solo que sin link clickeable.
APP_BASE_URL=""

# No hace falta ninguna variable para la búsqueda de dirección en "Ubicación" del panel de
# admin: usa Nominatim (OpenStreetMap), que es gratis y no pide API key.

# Suscripciones (Mercado Pago). Apagado por defecto: mientras esté en "false", no afecta a
# ninguna escuela real ni se muestra nada de facturación. Ver src/lib/mercadopago.ts y
# scripts/create-subscription-plan.ts.
SUBSCRIPTIONS_ENABLED="false"
# Access Token de tu app en https://www.mercadopago.com.ar/developers — usar el de TEST
# mientras se prueba, y recién pasar al de PRODUCCIÓN cuando esté todo validado.
MP_ACCESS_TOKEN=""
# Secreto de "Firma secreta" en Tu aplicación -> Notificaciones -> Webhooks, para validar
# que las notificaciones realmente vienen de Mercado Pago (header x-signature).
MP_WEBHOOK_SECRET=""
# Id del plan único, generado UNA sola vez con `npx tsx scripts/create-subscription-plan.ts`.
MP_PLAN_ID=""
# Precio mensual del plan único, en ARS (sin puntos ni comas, ej. 5000).
SUBSCRIPTION_PRICE_ARS=""
# Días de prueba gratis, sin pedir tarjeta — arrancan cuando el super-admin aprueba la
# escuela, no cuando paga.
SUBSCRIPTION_TRIAL_DAYS="7"
# Días de gracia tras un cobro recurrente fallido, antes de suspender el panel.
SUBSCRIPTION_GRACE_DAYS="2"
# Secreto simple para proteger /api/internal/check-subscriptions (el job que corre cada
# hora vía el Programador de tareas de Windows). Cualquier string largo y aleatorio sirve.
INTERNAL_CRON_SECRET=""

# Cierre por horario de las páginas públicas de asistencia (check-in, historial, clases
# anteriores, Itinerancias) — ver @/lib/business-hours. Apagado por defecto: mientras esté
# en "false", nunca se cierra nada. Nunca afecta al panel de administración.
PUBLIC_HOURS_ENABLED="false"
PUBLIC_HOURS_OPEN="08:00"
PUBLIC_HOURS_CLOSE="22:00"

# Slug (el de la URL /escuela/<slug>) de la única escuela que tiene habilitada la sección
# "Itinerancias" (evento trimestral: marzo/junio/septiembre/diciembre). Vacío = nadie la ve.
ITINERANCIAS_SCHOOL_SLUG=""

# Encuentro (fotos/video del evento, /encuentro): sección aparte, sin base de datos, ver
# OPERACIONES.md. Vacío EVENT_UPLOAD_CODE = la sección queda deshabilitada. El código es el
# que va en el QR (/encuentro?c=CODIGO) — cualquier string sirve, no hace falta que sean
# solo números. EVENT_UPLOADS_ENABLED sirve para cerrar la subida después del evento sin
# tener que borrar el código. El link/token de la galería NO va acá: se genera y se guarda
# en storage/evento/config.json desde el propio panel del super-admin.
EVENT_UPLOAD_CODE=""
EVENT_UPLOADS_ENABLED="false"
