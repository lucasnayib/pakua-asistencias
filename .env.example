DATABASE_URL="file:./dev.db"

# Sesión de administrador
SESSION_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-en-produccion"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Poner en "true" solo cuando la app se sirva por HTTPS (ej. detrás de un túnel de
# Cloudflare o en producción con dominio propio). Mientras se acceda por HTTP en la
# LAN, dejar sin definir o en "false" — si no, el navegador descarta las cookies de sesión.
COOKIE_SECURE="false"

# Google Drive (opcional). Si se dejan vacíos, la exportación solo descarga el archivo localmente.
# 1. Crear un Service Account en Google Cloud Console con la API de Drive habilitada.
# 2. Compartir la carpeta de destino con el email del Service Account.
# 3. Completar estas variables con los datos del JSON de credenciales.
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# Mails de solicitud de escuela nueva (opcional). Si se dejan vacíos, el registro/aprobación/
# rechazo de escuelas sigue funcionando igual, simplemente no se envía ningún mail.
# 1. Usar una cuenta de Gmail (puede ser una nueva, ej. notificaciones@tuescuela).
# 2. Activar la verificación en dos pasos en esa cuenta y generar una "contraseña de aplicación"
#    en https://myaccount.google.com/apppasswords — esa es la que va en EMAIL_SMTP_APP_PASSWORD,
#    NO la contraseña normal de la cuenta.
EMAIL_SMTP_USER=""
EMAIL_SMTP_APP_PASSWORD=""
# A dónde llegan los avisos de "solicitud de escuela nueva".
EMAIL_ADMIN_NOTIFICATIONS=""

# Opcional: si está seteada, los mails incluyen links directos al panel/escuela (ej.
# "https://tudominio.com"). Sin dominio propio todavía, dejar vacío — los mails igual
# se mandan, solo que sin link clickeable.
APP_BASE_URL=""

# No hace falta ninguna variable para la búsqueda de dirección en "Ubicación" del panel de
# admin: usa Nominatim (OpenStreetMap), que es gratis y no pide API key.

# Suscripciones (Mercado Pago). Apagado por defecto: mientras esté en "false", no afecta a
# ninguna escuela real ni se muestra nada de facturación. Ver src/lib/mercadopago.ts y
# scripts/create-subscription-plan.ts.
SUBSCRIPTIONS_ENABLED="false"
# Access Token de tu app en https://www.mercadopago.com.ar/developers — usar el de TEST
# mientras se prueba, y recién pasar al de PRODUCCIÓN cuando esté todo validado.
MP_ACCESS_TOKEN=""
# Secreto de "Firma secreta" en Tu aplicación -> Notificaciones -> Webhooks, para validar
# que las notificaciones realmente vienen de Mercado Pago (header x-signature).
MP_WEBHOOK_SECRET=""
# Id del plan único, generado UNA sola vez con `npx tsx scripts/create-subscription-plan.ts`.
MP_PLAN_ID=""
# Precio mensual del plan único, en ARS (sin puntos ni comas, ej. 5000).
SUBSCRIPTION_PRICE_ARS=""
# Días de prueba gratis, sin pedir tarjeta — arrancan cuando el super-admin aprueba la
# escuela, no cuando paga.
SUBSCRIPTION_TRIAL_DAYS="7"
# Días de gracia tras un cobro recurrente fallido, antes de suspender el panel.
SUBSCRIPTION_GRACE_DAYS="2"
# Secreto simple para proteger /api/internal/check-subscriptions (el job que corre cada
# hora vía el Programador de tareas de Windows). Cualquier string largo y aleatorio sirve.
INTERNAL_CRON_SECRET=""
