// Prisma schema — Sistema de Asistencias Pakua
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String   @default("")
  slug         String   @unique
  role         String   @default("ADMIN") // "ADMIN" | "SUPER_ADMIN"
  active       Boolean  @default(true)
  approved     Boolean  @default(true)
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  // 2FA (TOTP): pensado únicamente para la cuenta de SUPER_ADMIN. twoFactorSecret y
  // twoFactorBackupCodes nunca deben devolverse en ningún select de API salvo lo
  // estrictamente necesario para la verificación server-side del propio login.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  twoFactorBackupCodes String? // JSON: array de hashes bcrypt, uno por código, uso único

  // Restricción de asistencia por ubicación (opcional, por escuela). Si alguno de los tres
  // campos es null, no se aplica ninguna restricción — la asistencia funciona como siempre.
  latitude               Float?
  longitude              Float?
  attendanceRadiusMeters Int?

  // Cambio pendiente de mail de contacto o de contraseña, esperando el código de
  // confirmación mandado por mail. Solo uno a la vez por cuenta: pedir uno nuevo pisa el
  // anterior. pendingChangeValue guarda el mail nuevo en texto plano (para EMAIL) o el
  // passwordHash ya calculado (para PASSWORD, nunca la contraseña en texto plano).
  pendingChangeType      String? // "EMAIL" | "PASSWORD"
  pendingChangeValue     String?
  pendingChangeCodeHash  String?
  pendingChangeExpiresAt DateTime?

  // Suscripción (Mercado Pago). Una escuela tiene como mucho una, así que va directo acá
  // en vez de un modelo aparte. Solo aplica a role "ADMIN" — el super-admin no factura.
  subscriptionStatus  String    @default("UNPAID") // UNPAID | ACTIVE | PAST_DUE | SUSPENDED | CANCELED
  trialEndsAt         DateTime?
  trialWarningSentAt  DateTime?
  currentPeriodEnd    DateTime?
  periodWarningSentAt DateTime?
  graceEndsAt         DateTime?
  mpPreapprovalId     String?
  mpPayerEmail        String?

  // Baja automática por inactividad: si un alumno con al menos una asistencia registrada
  // pasa este número de días sin ninguna asistencia nueva, se lo da de baja solo (active =
  // false), igual que si un admin lo hubiera dado de baja a mano. null = desactivado (default).
  inactivityDeactivationDays Int?

  // Itinerancias (evento trimestral, exclusivo de una escuela vía ITINERANCIAS_SCHOOL_SLUG):
  // código propio para que los alumnos entren solo a esa sección desde su celular, sin usar
  // la contraseña real de la escuela. Hasheado igual que passwordHash. null = todavía no lo
  // configuraron.
  itineranciaAccessCodeHash String?

  // Guía interactiva del panel: null = todavía no se le ofreció/completó (se le muestra el
  // cartel de "¿querés un recorrido guiado?" la primera vez que entra con la suscripción ya
  // activa). Se puede volver a hacer desde "Mi cuenta" en cualquier momento sin tocar este
  // campo — solo se escribe una vez, al decir que no o al terminar/saltar la primera vez.
  onboardingCompletedAt DateTime?

  students               Student[]
  schedules              Schedule[]
  orientadores           Orientador[]
  exportLogs             ExportLog[]
  itineranciaActivities  ItineranciaActivity[]
  tiposArancel           TipoArancel[]
  pagosArancel           PagoArancel[]
  movimientosFinancieros MovimientoFinanciero[]
}

model Student {
  id             String              @id @default(cuid())
  adminId        String
  admin          Admin               @relation(fields: [adminId], references: [id])
  firstName      String
  lastName       String
  photoUrl       String?
  formacion      String?
  graduacion     String?
  evaluationDate String?
  graduacionDelivered   Boolean @default(false)
  graduacionDeliveredAt String? // "YYYY-MM-DD" — igual formato que evaluationDate
  dni            String?
  birthDate      String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  schedules                StudentSchedule[]
  attendances              Attendance[]
  orientadores             OrientadorStudent[]
  itineranciaRegistrations ItineranciaStudentRegistration[]
  graduationHistory        StudentGraduationHistory[]
  migrations               StudentMigration[]
  aranceles                AlumnoArancel[]
  pagosArancel             PagoArancel[]

  @@index([lastName, firstName])
  @@index([adminId])
}

// Historial de graduaciones (cintos) anteriores de un alumno. Se completa solo cuando se
// cambia la graduación actual desde el formulario de edición (guardando la anterior), y
// también a mano desde la ficha del alumno, para poder cargar el historial previo a esta
// función o corregir algo.
model StudentGraduationHistory {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  graduacion   String
  authorizedAt String? // "YYYY-MM-DD", mismo formato string que Student.evaluationDate
  delivered    Boolean  @default(false)
  deliveredAt  String? // "YYYY-MM-DD" — se pide al marcar "entregado", null mientras esté pendiente
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
}

// Migración de un alumno de una escuela a otra: la escuela de origen genera un código de
// un solo uso (ver src/lib/student-migration.ts), y quien lo reclame primero (destino
// destino-agnóstico, no hay una escuela destino pre-acordada) crea un alumno nuevo con la
// identidad/graduación copiadas y da de baja al viejo. destinationAdminId/newStudentId son
// referencias sueltas (igual que AuditLog.adminId/entityId), no relaciones Prisma reales —
// solo quedan para auditoría, no participan de la integridad referencial viva.
model StudentMigration {
  id                 String    @id @default(cuid())
  studentId          String
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  codeHash           String // sha256(code), no bcrypt: hace falta poder buscarlo por índice sin
  // saber de antemano a qué alumno pertenece (con bcrypt solo se puede escanear y comparar
  // uno por uno). Con un espacio de 6 dígitos, bcrypt no suma protección real contra fuerza
  // bruta — la protección real es el rate limit — mismo criterio que passwordFingerprint en
  // src/lib/auth.ts para un secreto corto de un solo uso.
  status             String    @default("PENDING") // "PENDING" | "COMPLETED" | "CANCELED"
  // "EXPIRED" nunca se guarda acá: se calcula al vuelo (status == "PENDING" && expiresAt <
  // now()), mismo criterio que Admin.pendingChangeExpiresAt.
  expiresAt          DateTime
  destinationAdminId String?
  newStudentId       String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([studentId])
  @@index([codeHash])
  @@index([status, expiresAt])
}

model Orientador {
  id        String              @id @default(cuid())
  adminId   String
  admin     Admin               @relation(fields: [adminId], references: [id])
  firstName String
  lastName  String
  email     String?
  phone     String?
  photoUrl  String?
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  students  OrientadorStudent[]

  @@index([lastName, firstName])
  @@index([adminId])
}

model OrientadorStudent {
  id           String     @id @default(cuid())
  orientadorId String
  studentId    String
  createdAt    DateTime   @default(now())
  orientador   Orientador @relation(fields: [orientadorId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([orientadorId, studentId])
}

model Schedule {
  id          String            @id @default(cuid())
  adminId     String
  admin       Admin             @relation(fields: [adminId], references: [id])
  name        String?
  startTime   String // "HH:mm"
  endTime     String // "HH:mm"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  days        ScheduleDay[]
  students    StudentSchedule[]
  attendances Attendance[]

  @@index([adminId])
}

model ScheduleDay {
  id         String   @id @default(cuid())
  scheduleId String
  dayOfWeek  Int // 0=domingo ... 6=sábado (Date.getDay())
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek])
}

model StudentSchedule {
  id         String   @id @default(cuid())
  studentId  String
  scheduleId String
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleId])
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  scheduleId String
  date       String // "YYYY-MM-DD"
  time       String // "HH:mm:ss"
  status     String   @default("PRESENTE")
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleId, date])
  @@index([date])
}

model ExportLog {
  id            String   @id @default(cuid())
  adminId       String
  admin         Admin    @relation(fields: [adminId], references: [id])
  filename      String
  format        String // XLSX | PDF | TXT
  dateFrom      String
  dateTo        String
  driveUploaded Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([adminId])
}

model ItineranciaActivity {
  id          String   @id @default(cuid())
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id])
  title       String
  description String?
  category    String // "EVALUACION" | "SEMINARIO" | "CURSO" | "COMPENSATORIOS" | "CLASES_ESPECIALES"
  location    String? // "CORDOBA" | "ALTA_GRACIA" — null en actividades creadas antes de este campo
  date        String // "YYYY-MM-DD"
  startTime   String // "HH:mm"
  endTime     String // "HH:mm"
  period      String? // null = activa (panel principal); no-null = archivada bajo esta
                       // etiqueta ("Itinerancias Septiembre 2026") tras un cierre manual o automático
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentRegistrations ItineranciaStudentRegistration[]

  @@index([adminId])
  @@index([date])
  @@index([adminId, period])
}

model ItineranciaStudentRegistration {
  id         String              @id @default(cuid())
  activityId String
  activity   ItineranciaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  // Auto-check-in del propio alumno el día de la actividad (igual que Attendance, pero acá la
  // inscripción y la asistencia comparten la misma fila en vez de dos modelos separados). null =
  // inscripto pero todavía no se marcó presente.
  attendedAt DateTime?

  @@unique([activityId, studentId])
}

// Catálogo de tipos de arancel de la escuela (abierto: el admin agrega los que necesite —
// Yoga, Arte Marcial, Clases de Mejoramiento, un curso puntual, etc.). El monto es el mismo
// para todos los alumnos anotados a ese tipo.
model TipoArancel {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  name      String
  amount    Int // pesos enteros, sin decimales
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments AlumnoArancel[]
  payments    PagoArancel[]

  @@index([adminId])
}

// A qué tipos de arancel está anotado cada alumno (un alumno puede tener varios a la vez).
model AlumnoArancel {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tipoArancelId String
  tipoArancel   TipoArancel @relation(fields: [tipoArancelId], references: [id])
  active        Boolean     @default(true) // false = desanotado, se conserva el historial de pagos
  startMonth    String // "YYYY-MM": desde qué mes se le empieza a pedir este arancel
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([studentId, tipoArancelId])
  @@index([studentId])
}

// Un pago: alumno + tipo de arancel + mes. SOLO existen filas para lo efectivamente pagado —
// "no pagado" es la ausencia de fila, así no hace falta precrear/limpiar nada con una tarea
// programada (ver src/lib/aranceles-calc.ts).
model PagoArancel {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tipoArancelId String
  tipoArancel   TipoArancel @relation(fields: [tipoArancelId], references: [id])
  adminId       String // denormalizado a propósito: permite consultas directas del panel/resumen sin pasar por student
  admin         Admin       @relation(fields: [adminId], references: [id])
  month         String // "YYYY-MM"
  amount        Int // copia del monto de TipoArancel al momento de pagar: si después sube la
  // cuota, lo ya pagado no cambia retroactivamente.
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([studentId, tipoArancelId, month])
  @@index([adminId, month])
  @@index([studentId])
}

// Gastos e ingresos sueltos, no atados a un alumno (alquiler, insumos, donaciones, venta de
// merchandising, etc.).
model MovimientoFinanciero {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  tipo      String // "INGRESO" | "EGRESO"
  categoria String // ver CATEGORIAS_INGRESO/CATEGORIAS_EGRESO en src/lib/validations.ts
  concepto  String
  amount    Int
  date      String // "YYYY-MM-DD"
  estado    String   @default("PAGADO") // "PAGADO" | "NO_PAGADO" — solo lo PAGADO entra en los totales
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  actor     String
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
